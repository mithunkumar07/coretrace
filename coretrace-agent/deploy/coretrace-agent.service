[Unit]
Description=CoreTrace Agent - SSH Session Monitoring
Documentation=https://docs.coretrace.io
After=network.target auditd.service
Wants=auditd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/coretrace-agent monitor --config /etc/coretrace/config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coretrace-agent

# Security settings (adjust based on your needs)
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

# Resource limits
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
